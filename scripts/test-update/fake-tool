#!/usr/bin/env bash
set -euo pipefail
[[ $HOME == /tmp/* ]] || { echo "refusing: HOME=$HOME"; exit 99; }
helper=${P3STACK_TEST_HELPER:?refusing: missing test helper}
python3 -I "$helper/safe-home.py" check --owned

tool=$(basename "$0")
origin=$P3STACK_REPO_URL

subtree() {
  case $1 in
    p3stack) echo p3stack ;;
    p3stack-team-kit) echo team-kit ;;
  esac
}

export_tree() {
  local commit=$1 path=$2 dest=$3
  rm -rf "$dest"
  mkdir -p "$dest"
  git --git-dir="$origin" archive "$commit" $path | tar -x -C "$dest" ${path:+--strip-components=1}
}

unsupported() {
  echo "fake $tool doesn't support: $*" >&2
  exit 1
}

act_as_merge_agent() {
  printf '%s in %s: %s\n' "$tool" "$PWD" "$*" >>"$HOME/agent.log"
  [[ -n ${P3STACK_FAKE_MERGE:-} ]] || exit 0
  local yours
  yours=$(ls yours*)
  printf '%s\n' "$P3STACK_FAKE_MERGE" >"result${yours#yours}"
}

claude_plugins=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins
claude_state=$claude_plugins/installed.tsv

claude_list_json() {
  if [[ -n ${P3STACK_FAKE_JSON:-} && $P3STACK_FAKE_JSON != reordered ]]; then printf '%s\n' "$P3STACK_FAKE_JSON"; return; fi
  local plugin path version first=1
  printf '[\n'
  while IFS=$'\t' read -r plugin path version; do
    ((first)) || printf ',\n'
    first=0
    if [[ ${P3STACK_FAKE_JSON:-} == reordered ]]; then
      printf '  {"installPath":"%s","nested":{"a":1},"id":"%s@p3stack"}' "$path" "$plugin"
      continue
    fi
    printf '  {\n    "id": "%s@p3stack",\n    "version": "%s",\n    "scope": "user",\n    "enabled": true,\n    "installPath": "%s",\n    "installedAt": "2026-01-01T00:00:00.000Z",\n    "lastUpdated": "2026-01-01T00:00:00.000Z",\n    "projectEnabled": true\n  }' "$plugin" "$version" "$path"
  done < <(LC_ALL=C sort -r "$claude_state" 2>/dev/null)
  printf '\n]\n'
}

claude_put() {
  local plugin=${1%@*} sha version dest
  sha=$(git --git-dir="$origin" rev-parse HEAD)
  version=${sha:0:12}
  dest=$claude_plugins/cache/p3stack/$plugin/$version
  [[ -d $dest ]] || export_tree "$sha" "$(subtree "$plugin")" "$dest"
  mkdir -p "$claude_plugins"
  { grep -v "^$plugin	" "$claude_state" 2>/dev/null || true; printf '%s\t%s\t%s\n' "$plugin" "$dest" "$version"; } >"$claude_state.new"
  mv "$claude_state.new" "$claude_state"
}

claude() {
  case "$*" in
    "plugin marketplace add "*) mkdir -p "$claude_plugins"; touch "$claude_plugins/marketplace" ;;
    "plugin marketplace remove "*) rm -f "$claude_plugins/marketplace" ;;
    "plugin marketplace update "*) : ;;
    "plugin marketplace list")
      printf 'Configured marketplaces:\n\n  ❯ anthropic-plugin-directory\n    Source: Built in (Anthropic Directory)\n\n'
      [[ ! -f $claude_plugins/marketplace ]] || printf '  ❯ p3stack\n    Source: GitHub (sandwichlegend/p3stack)\n\n' ;;
    "plugin install "*) grep -q "^${3%@*}	" "$claude_state" 2>/dev/null || claude_put "$3" ;;
    "plugin update "*) [[ ${P3STACK_FAKE_SKIP_UPDATE:-} == "${3%@*}" ]] || claude_put "$3";
      if [[ -n ${P3STACK_FAKE_REMOVE_AFTER_UPDATE:-} && $3 == p3stack@p3stack ]]; then
        rm -rf "$claude_plugins/cache/p3stack/p3stack/$(git --git-dir="$origin" rev-parse HEAD | cut -c1-12)/$P3STACK_FAKE_REMOVE_AFTER_UPDATE"
      fi; [[ ${P3STACK_FAKE_FAIL_AFTER_UPDATE:-} != claude || $3 != p3stack-team-kit@p3stack ]] ;;
    "plugin uninstall "*) grep -v "^${3%@*}	" "$claude_state" >"$claude_state.new" || true; mv "$claude_state.new" "$claude_state" ;;
    "plugin list --json") claude_list_json ;;
    "plugin list")
      if [[ ! -s $claude_state ]]; then echo 'No plugins installed. Use `claude plugin install` to install a plugin.'; return; fi
      printf 'Installed plugins:\n\n'
      while IFS=$'\t' read -r plugin path version; do
        printf '  ❯ %s@p3stack\n    Version: %s\n    Scope: user\n    Status: ✔ enabled\n\n' "$plugin" "$version"
      done < <(LC_ALL=C sort -r "$claude_state")
      printf '\n' ;;

    "plugin "*) unsupported "$@" ;;
    *) act_as_merge_agent "$@" ;;
  esac
}

codex_home=${CODEX_HOME:-$HOME/.codex}
codex_market=$codex_home/.tmp/marketplaces/p3stack
codex_state=$codex_home/plugins/installed.txt

codex() {
  if [[ ! -d $codex_home ]]; then
    printf 'WARNING: proceeding, even though we could not create PATH aliases: CODEX_HOME points to "%s", but that path does not exist\nError: failed to resolve CODEX_HOME\n\nCaused by:\n    CODEX_HOME points to "%s", but that path does not exist\n' "$codex_home" "$codex_home" >&2
    return 1
  fi
  case "$*" in
    "plugin marketplace add "*) [[ -d $codex_market ]] || git clone --quiet "$origin" "$codex_market" ;;
    "plugin marketplace upgrade "*)
      git -C "$codex_market" pull --quiet --ff-only
      if [[ -f $codex_state ]]; then
        while IFS= read -r installed; do
          export_tree "$(git -C "$codex_market" rev-parse HEAD)" "$(subtree "${installed%@*}")" "$codex_home/plugins/cache/p3stack/${installed%@*}/1.0.0"
        done <"$codex_state"
      fi ;;
    "plugin marketplace list")
      if [[ -d $codex_market ]]; then printf 'MARKETPLACE  ROOT\np3stack      %s\n' "$codex_market"
      else echo 'No plugin marketplaces in scope.'; fi ;;
    "plugin marketplace remove "*) rm -rf "$codex_market" ;;
    "plugin list --json")
      python3 -I - "$codex_state" "$codex_market" <<'JSON'
import json, pathlib, sys
state, market = map(pathlib.Path, sys.argv[1:])
rows = []
for plugin in state.read_text().splitlines() if state.exists() else []:
    name = plugin.split('@')[0]
    rows.append(dict(pluginId=plugin, name=name, marketplaceName='p3stack', version='1.0.0', installed=True, enabled=True,
        source=dict(source='local', path=str(market / ('p3stack' if name == 'p3stack' else 'team-kit'))),
        marketplaceSource=dict(sourceType='git', source='https://github.com/sandwichlegend/p3stack.git'),
        installPolicy='AVAILABLE', authPolicy='ON_INSTALL'))
print(json.dumps(dict(installed=rows, available=[]), indent=2))
JSON
      ;;
    "plugin list")
      [[ -d $codex_market ]] || return 0
      printf 'Marketplace `p3stack`\n%s/.agents/plugins/marketplace.json\n\n' "$codex_market"
      if [[ -s $codex_state ]]; then printf 'PLUGIN                    STATUS              VERSION  SOURCE\n'
      else printf 'PLUGIN                    STATUS         VERSION  SOURCE\n'; fi
      for plugin in p3stack p3stack-team-kit; do
        if grep -qx "$plugin@p3stack" "$codex_state" 2>/dev/null; then
          printf '%-26s%s  1.0.0    %s/%s\n' "$plugin@p3stack" 'installed, enabled' "$codex_market" "$(subtree "$plugin")"
        else
          printf '%-26s%s           %s/%s\n' "$plugin@p3stack" 'not installed' "$codex_market" "$(subtree "$plugin")"
        fi
      done ;;

    "plugin add "*)
      mkdir -p "$(dirname "$codex_state")"
      { grep -vFx "$3" "$codex_state" 2>/dev/null || true; echo "$3"; } >"$codex_state.new"
      mv "$codex_state.new" "$codex_state"
      export_tree "$(git -C "$codex_market" rev-parse HEAD)" "$(subtree "${3%@*}")" "$codex_home/plugins/cache/p3stack/${3%@*}/1.0.0"; [[ ${P3STACK_FAKE_FAIL_AFTER_UPDATE:-} != codex || $3 != p3stack-team-kit@p3stack ]] ;;
    "plugin remove "*)
      { grep -vFx "$3" "$codex_state" 2>/dev/null || true; } >"$codex_state.new"
      mv "$codex_state.new" "$codex_state"
      rm -rf "$codex_home/plugins/cache/p3stack/${3%@*}" ;;

    "plugin "*) unsupported "$@" ;;
    *) act_as_merge_agent "$@" ;;
  esac
}

opencode_cache=${XDG_CACHE_HOME:-$HOME/.cache}/opencode/npm/git-p3stack-0123456789ab
opencode_state=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/p3stack-installed

opencode_put() {
  local sha stamp dir
  sha=$(git --git-dir="$origin" rev-parse HEAD)
  mkdir -p "$opencode_cache" "$(dirname "$opencode_state")"
  printf '%s\n' "$sha" >"$opencode_state"
  printf '%s\n' "$sha" >"$HOME/opencode-last-commit"
  stamp=$(ls "$opencode_cache" | LC_ALL=C sort | tail -1)
  stamp=${stamp:-0000000000001}
  if [[ ${P3STACK_FAKE_OPENCODE_NEW_FOLDER:-} == 1 ]]; then
    stamp=$(printf '%013d' $(($(ls "$opencode_cache" | wc -l) + 1)))
  fi
  printf '{"plugins":["github:sandwichlegend/p3stack"]}\n' >"$(dirname "$opencode_state")/opencode.json"
  dir=$opencode_cache/$stamp/node_modules
  export_tree "$sha" "" "$dir/p3stack"
  printf '{\n  "packages": {\n    "node_modules/p3stack": {\n      "resolved": "git+ssh://git@github.com/sandwichlegend/p3stack.git#%s"\n    }\n  }\n}\n' "$sha" >"$dir/.package-lock.json"
}

opencode() {
  case "$*" in
    --version) echo 2.1.4 ;;
    "plugin marketplace "*) cat <<'HELP'
DESCRIPTION
  Manage plugins

USAGE
  opencode plugin <subcommand> [flags]

GLOBAL FLAGS
  --help, -h                                                          Show help information
  --version, -v                                                       Show version information
  --wizard                                                            Start wizard mode for a command
  --completions <bash|zsh|fish|sh>                                    Print shell completion script (choices: bash, zsh, fish, sh)
  --log-level <all|trace|debug|info|warn|warning|error|fatal|none>    Sets the minimum log level (choices: all, trace, debug, info, warn, warning, error, fatal, none)
  --print-logs                                                        Print logs to stderr (server logs require --standalone)

SUBCOMMANDS
  list      List plugins
  add       Install a plugin and add it to the global configuration
  check     Check package plugins for updates
  update    Update package plugins
  remove    Remove a plugin from global configuration

ERROR
  Unknown subcommand "marketplace" for "opencode plugin"
HELP
      return 1 ;;
    "plugin add "*) [[ -f $opencode_state ]] || opencode_put ;;
    "plugin update "*) opencode_put ;;
    "plugin remove "*) rm -f "$opencode_state"; printf '{"plugins":[]}\n' >"$(dirname "$opencode_state")/opencode.json" ;;
    "plugin list")
      local count=0
      [[ ! -f $HOME/opencode-list-count ]] || count=$(cat "$HOME/opencode-list-count")
      count=$((count+1)); echo "$count" >"$HOME/opencode-list-count"
      if [[ ${P3STACK_FAKE_OPENCODE_STALE:-} == empty && $count -le ${P3STACK_FAKE_OPENCODE_STALE_CALLS:-99999} ]]; then echo 'No plugins found'; return; fi
      if [[ ${P3STACK_FAKE_OPENCODE_STALE:-} == installed && $count -le ${P3STACK_FAKE_OPENCODE_STALE_CALLS:-99999} ]]; then
        printf 'ID       VERSION  SOURCE\np3stack  %.7s  github:sandwichlegend/p3stack\n' "$(cat "$HOME/opencode-last-commit")"
        return
      fi
      if [[ -f $opencode_state ]]; then
        printf 'ID       VERSION  SOURCE\np3stack  %.7s  github:sandwichlegend/p3stack\n' "$(cat "$opencode_state")"
      else echo 'No plugins found'; fi ;;
    "plugin "*) unsupported "$@" ;;
    *) act_as_merge_agent "$@" ;;
  esac
}

case $tool in
  claude|codex|opencode) "$tool" "$@" ;;
  cursor-agent)
    if [[ $* == 'plugin marketplace list' ]]; then
      echo "Error: Authentication required. Run 'agent login', pass --api-key/--auth-token, or set CURSOR_API_KEY/CURSOR_AUTH_TOKEN." >&2
      exit 1
    fi
    act_as_merge_agent "$@" ;;
  *) act_as_merge_agent "$@" ;;
esac
